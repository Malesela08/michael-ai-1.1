{
  "name": "Michael AI Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "updateContentCommand": "pip install --user -r requirements.txt",
  "postCreateCommand": "bash .devcontainer/setup-ollama.sh",
  "postStartCommand": "ollama serve & sleep 3 && ollama pull llama3.2",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
